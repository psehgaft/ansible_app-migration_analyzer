<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Migration Report - .NET / VB to .NET Core and Quarkus</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; padding: 20px; }
        .card-metric { border-left: 5px solid #0d6efd; }
        .badge-high { background-color: #dc3545; }
        .badge-med { background-color: #ffc107; color: #000; }
        .badge-low { background-color: #198754; }
    </style>
</head>
<body>
    <div class="container">
        <h1 class="mb-4">Source-Code Migration Analysis Report</h1>
        <p class="text-muted"><strong>Analyzed Path:</strong> {{ source_code_path }}</p>
        
        <hr>

        <!-- Executive summary -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card card-metric p-3 shadow-sm">
                    <h5>Total Classes</h5>
                    <h2>{{ analysis.total_classes }}</h2>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card card-metric p-3 shadow-sm">
                    <h5>Lines of Code (LOC)</h5>
                    <h2>{{ analysis.total_loc }}</h2>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card card-metric p-3 shadow-sm">
                    <h5>C# / VB Files</h5>
                    <h2>{{ analysis.total_files_cs }} / {{ analysis.total_files_vb }}</h2>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card card-metric p-3 shadow-sm">
                    <h5>WSDLs Found</h5>
                    <h2>{{ analysis.wsdl_files | length }}</h2>
                </div>
            </div>
        </div>

        <!-- Complexity assessment -->
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Target: .NET Core / .NET 8+</h5>
                    </div>
                    <div class="card-body">
                        <h4>Effort Level: <span class="badge bg-secondary">{{ analysis.score_net_core }}</span></h4>
                        <p>This is the more direct platform migration. Much of the C# code can be reused, but System.Web and WCF dependencies require remediation.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-danger text-white">
                        <h5 class="mb-0">Target: Java (Quarkus)</h5>
                    </div>
                    <div class="card-body">
                        <h4>Effort Level: <span class="badge bg-secondary">{{ analysis.score_quarkus }}</span></h4>
                        <p>This path requires rewriting or translating C#/VB syntax to Java. SOAP contracts require a supported implementation such as Quarkus CXF.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Technical findings -->
        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <h5 class="mb-0">Detected Blockers and Complexity Factors</h5>
            </div>
            <div class="card-body">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Legacy Pattern / Component</th>
                            <th>Occurrences</th>
                            <th>.NET Core Impact</th>
                            <th>Quarkus Impact</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>WCF / SOAP Services (System.ServiceModel)</td>
                            <td>{{ analysis.findings.wcf_usages }}</td>
                            <td><span class="badge badge-med">Medium</span> (Use CoreWCF / gRPC)</td>
                            <td><span class="badge badge-high">High</span> (Use Quarkus CXF)</td>
                        </tr>
                        <tr>
                            <td>Legacy Web Logic (System.Web)</td>
                            <td>{{ analysis.findings.system_web_usages }}</td>
                            <td><span class="badge badge-high">High</span> (Migrate to ASP.NET Core)</td>
                            <td><span class="badge badge-high">High</span> (Rewrite with Jakarta REST)</td>
                        </tr>
                        <tr>
                            <td>ASP.NET Web Forms Views (.aspx)</td>
                            <td>{{ analysis.findings.aspx_files }}</td>
                            <td><span class="badge badge-high">Critical</span> (Incompatible)</td>
                            <td><span class="badge badge-high">Critical</span> (Incompatible; use a web frontend)</td>
                        </tr>
                        <tr>
                            <td>Native Windows API Usage (DllImport/Registry)</td>
                            <td>{{ analysis.findings.win_api_usages }}</td>
                            <td><span class="badge badge-high">High</span> (Blocks Linux/containers)</td>
                            <td><span class="badge badge-high">High</span> (Incompatible with Linux)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Extracted WSDL files -->
        {% if analysis.wsdl_files | length > 0 %}
        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="mb-0">WSDL Files Copied for Review</h5>
            </div>
            <div class="card-body">
                <ul class="list-group">
                    {% for wsdl in analysis.wsdl_files %}
                    <li class="list-group-item">{{ wsdl | basename }} <small class="text-muted">({{ wsdl }})</small></li>
                    {% endfor %}
                </ul>
            </div>
        </div>
        {% endif %}
    </div>
</body>
</html>
